class Solution {
    public int[] findMissingRepeatingNumbers(int[] nums) {

        int[] freq = new int[nums.length + 1];

        for (int i = 0; i < nums.length; i++) {
            freq[nums[i]]++;
        }

        int repeat = -1;
        int miss = -1;

        for (int i = 1; i <= nums.length; i++) {

            if (freq[i] == 2) {
                repeat = i;
            }

            if (freq[i] == 0) {
                miss = i;
            }
        }

        return new int[]{repeat, miss};
    }
}
